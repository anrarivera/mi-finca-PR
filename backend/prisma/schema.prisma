generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  // Ephemeral try-before-signup accounts ("Probar la demo") — seeded with
  // a sample farm, excluded from digests, purged by cron after a few days.
  isDemo            Boolean   @default(false)
  passwordHash      String?
  fullName          String
  profilePhotoUrl   String?
  language          String    @default("es")
  unitSystem        String    @default("imperial")
  emailVerified     Boolean   @default(false)
  notificationPrefs Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  farms             Farm[]
  oauthAccounts     OAuthAccount[]
  cropTypes         CropType[]
  cropSchedules     CropSchedule[]
  actionTokens      ActionToken[]
  farmMemberships   FarmMember[]
  performedOperations   Operation[]          @relation("PerformedOperations")
  performedFindings     Finding[]            @relation("PerformedFindings")
  performedObservations FindingObservation[] @relation("PerformedObservations")

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Farm {
  id             String    @id @default(uuid())
  userId         String
  name           String
  location       String
  farmType       String    @default("mixed")
  boundary       Json      @default("[]")
  totalAreaAcres Decimal   @default(0) @db.Decimal(10, 4)
  isFavorite     Boolean   @default(false)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields         Field[]
  livestockUnits LivestockUnit[]
  harvestYields  HarvestYield[]
  sensors        Sensor[]
  automationRules AutomationRule[]
  operations     Operation[]
  members        FarmMember[]
  invites        FarmInvite[]

  @@map("farms")
}

// Beta/signup access codes (the signup gate). While SIGNUP_MODE=invite,
// registration requires one of these (or a valid farm invite code, which
// doubles as app access for invited workers). Hash-only storage, optional
// use cap, expiring, revocable. Generated via scripts/createSignupCode.
model SignupCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  note      String?
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("signup_codes")
}

// Join codes (roles: self-serve onboarding). Multi-use until expiry or
// revocation so one code can onboard a whole crew; only a SHA-256 hash is
// stored — the plain code is shown once at generation.
model FarmInvite {
  id        String    @id @default(uuid())
  farmId    String
  role      String    // 'admin' | 'operator' — baked into the code
  codeHash  String    @unique
  createdBy String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  farm      Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@map("farm_invites")
}

// Per-farm membership. The owner is Farm.userId (never a row here);
// members carry 'admin' (everything but farm deletion) or 'operator'
// (log work — labores, hallazgos, cosechas — but no farm/field structure).
model FarmMember {
  id        String   @id @default(uuid())
  farmId    String
  userId    String
  role      String   // 'admin' | 'operator'
  createdAt DateTime @default(now())
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@map("farm_members")
}

model Field {
  id             String    @id @default(uuid())
  farmId         String
  name           String
  // 'crops' (rows/plants) or 'livestock' (a corral — herds are assigned
  // to it and rendered on the map with head counts).
  kind           String    @default("crops")
  color          String
  shape          String
  boundary       Json      @default("[]")
  farmLat        Decimal   @db.Decimal(12, 8)
  farmLng        Decimal   @db.Decimal(12, 8)
  displayMode    String    @default("shape")
  isPositioning  Boolean   @default(false)
  isSimulated    Boolean   @default(false)
  farmModelId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  farm           Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  rows           FieldRow[]
  plants         PlantInstance[]
  plantingEvents PlantingEvent[]
  operations     Operation[]
  harvestYields  HarvestYield[]
  findings       Finding[]
  livestockUnits LivestockUnit[]

  @@map("fields")
}

model FieldRow {
  id                  String    @id @default(uuid())
  fieldId             String
  startLat            Decimal   @db.Decimal(12, 8)
  startLng            Decimal   @db.Decimal(12, 8)
  endLat              Decimal   @db.Decimal(12, 8)
  endLng              Decimal   @db.Decimal(12, 8)
  spacingFt           Decimal   @db.Decimal(6, 2)
  primaryCropTypeId   String
  companionCropTypeId String?
  plantingDate        DateTime  @db.Date
  // Contour rows: the drawn ring/arc as [{lat,lng},…] and whether it
  // closes. Straight rows leave these null (start/end suffice). Added
  // because the client always sent them and the server silently dropped
  // them — contour rings reloaded as straight lines.
  path                Json?
  pathClosed          Boolean?
  createdAt           DateTime  @default(now())
  field               Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  plants              PlantInstance[]

  @@map("field_rows")
}

model PlantInstance {
  id              String    @id @default(uuid())
  fieldId         String
  rowId           String?
  plantingEventId String?
  cropTypeId      String
  lat             Decimal   @db.Decimal(12, 8)
  lng             Decimal   @db.Decimal(12, 8)
  plantingDate    DateTime  @db.Date
  field           Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  row             FieldRow? @relation(fields: [rowId], references: [id])
  plantingEvent   PlantingEvent? @relation(fields: [plantingEventId], references: [id])

  @@map("plant_instances")
}

model PlantingEvent {
  id           String    @id @default(uuid())
  fieldId      String
  cropTypeId   String
  plantingDate DateTime  @db.Date
  plantCount   Int
  isSimulated  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  field        Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  plants       PlantInstance[]
  operations   Operation[]
  recommended  RecommendedOperation[]

  @@map("planting_events")
}

model RecommendedOperation {
  id                  String    @id @default(uuid())
  plantingEventId     String?
  livestockUnitId     String?
  templateId          String
  type                String
  labelEs             String
  recommendedDate     DateTime  @db.Date
  status              String    @default("pending")
  completedDate       DateTime? @db.Date
  completedOperationId String?
  notes               String?
  product             String?
  quantity            Decimal?  @db.Decimal(10, 3)
  unit                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  plantingEvent       PlantingEvent? @relation(fields: [plantingEventId], references: [id], onDelete: Cascade)
  livestockUnit       LivestockUnit? @relation(fields: [livestockUnitId], references: [id])
  completedOperation  Operation? @relation(fields: [completedOperationId], references: [id])
  treatedFindings     Finding[]

  @@map("recommended_operations")
}

// A scouting finding — a pest/disease observation (SDD: scouting feature).
// Separate entity from the operations log: findings are what the farmer SAW,
// operations are what the farmer DID. Linked to a treatment labor only by id
// reference, never merged. Scope reuses the tri-level model of operations:
// rowIds = fully affected rows, plantIds = individual plants outside those
// rows, both empty = field-level observation (sample-based scouting).
model Finding {
  id        String   @id @default(uuid())
  fieldId   String
  pestId    String
  severity  Int      @default(1) // 1 leve · 2 moderada · 3 severa
  status    String   @default("open") // open | treated | resolved
  foundDate DateTime @db.Date
  notes     String?
  rowIds    Json     @default("[]")
  plantIds  Json     @default("[]")
  // The treatment labor "Crear labor" generated from this finding — cleared
  // if that recommendation is ever deleted, so a new one can be created.
  treatmentRecommendedOperationId String?
  performedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  performedBy User?  @relation("PerformedFindings", fields: [performedByUserId], references: [id], onDelete: SetNull)
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  treatmentRecommendedOperation RecommendedOperation? @relation(fields: [treatmentRecommendedOperationId], references: [id], onDelete: SetNull)
  observations FindingObservation[]

  @@map("findings")
}

// One scouting visit to a finding — the re-inspection trail ("seguimiento",
// the Parcial of findings). The finding's own severity/scope mirror the
// LATEST observation so map paint and field health read the current state;
// the history here answers whether the treatment worked. Every finding has
// at least one observation (created with it).
model FindingObservation {
  id        String   @id @default(uuid())
  findingId String
  date      DateTime @db.Date
  severity  Int
  rowIds    Json     @default("[]")
  plantIds  Json     @default("[]")
  notes     String?
  performedByUserId String?
  createdAt DateTime @default(now())
  performedBy User?  @relation("PerformedObservations", fields: [performedByUserId], references: [id], onDelete: SetNull)
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@map("finding_observations")
}

model Operation {
  id                    String    @id @default(uuid())
  farmId                String
  fieldId               String?
  plantingEventId       String?
  livestockUnitId       String?
  recommendedOperationId String?
  type                  String
  actualDate            DateTime  @db.Date
  notes                 String?
  product               String?
  quantity              Decimal?  @db.Decimal(10, 3)
  unit                  String?
  qualityRating         Int?
  photoUrls             Json      @default("[]")
  // Which field rows this operation covered (array of field_rows ids).
  // Lets a harvest record "rows 1–3 today, rows 4–6 tomorrow". Empty array
  // means the whole field / not row-specific.
  rowIds                Json      @default("[]")
  // Individually covered plants (array of plant_instances ids) — for
  // selections finer than whole rows: "row 1 plus the first 5 plants of
  // row 2", or scattered single plants. rowIds = fully covered rows,
  // plantIds = extra individual plants outside those rows.
  plantIds              Json      @default("[]")
  // Herd-count change carried by this operation (negative = animals left
  // the herd: slaughtered/sold/died) and why — the livestock ledger.
  countDelta            Int?
  countReason           String?
  // Who logged the work — stamped at creation, kept if the member leaves.
  performedByUserId     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  performedBy           User?     @relation("PerformedOperations", fields: [performedByUserId], references: [id], onDelete: SetNull)
  farm                  Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field                 Field?    @relation(fields: [fieldId], references: [id])
  plantingEvent         PlantingEvent? @relation(fields: [plantingEventId], references: [id])
  livestockUnit         LivestockUnit? @relation(fields: [livestockUnitId], references: [id])
  recommendedOperations RecommendedOperation[]
  harvestYields         HarvestYield[]

  @@map("operations")
}

model HarvestYield {
  id          String    @id @default(uuid())
  farmId      String
  fieldId     String?
  // Link back to the operations-log entry that produced this yield, so
  // editing/deleting the log entry keeps the yield in sync. Null for yields
  // created directly through the harvests API.
  operationId String?
  // Crop harvests carry cropTypeId; animal production carries
  // livestockUnitId + productId (milk/eggs/meat/honey). One table = the
  // farm's unified production ledger.
  cropTypeId  String?
  livestockUnitId String?
  productId   String?
  quantity    Decimal   @db.Decimal(10, 2)
  unit        String
  // Total sale revenue for this entry (optional — much production is
  // eaten, given away, or unsold). Unit price is derived, never stored.
  revenue     Decimal?  @db.Decimal(10, 2)
  harvestDate DateTime  @db.Date
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  farm        Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field       Field?     @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  livestockUnit LivestockUnit? @relation(fields: [livestockUnitId], references: [id], onDelete: SetNull)

  @@map("harvest_yields")
}

model LivestockUnit {
  id              String    @id @default(uuid())
  farmId          String
  // The corral this herd lives in (a Field with kind 'livestock').
  // Nullable: herds can exist unassigned; moving herds between corrales
  // is pasture rotation.
  fieldId         String?
  name            String
  animalType      String
  currentCount    Int
  acquisitionDate DateTime  @db.Date
  farmLat         Decimal?  @db.Decimal(12, 8)
  farmLng         Decimal?  @db.Decimal(12, 8)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  farm            Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field           Field?    @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  operations      Operation[]
  recommended     RecommendedOperation[]
  harvestYields   HarvestYield[]

  @@map("livestock_units")
}

model CropType {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  nameEs    String
  emoji     String   @default("🌱")
  category  String   @default("Personalizados")
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules CropSchedule[]

  @@map("crop_types")
}

// One crop can carry several schedule rows: the base recipe (userId NULL —
// seeded for built-ins, the owner's own recipe for custom crops) plus
// per-user overrides of built-ins ("mi calendario para <crop>"). Readers
// collapse to one: the caller's row wins over the base.
model CropSchedule {
  id                     String   @id @default(uuid())
  cropTypeId             String
  userId                 String?
  harvestWindowStartDays Int
  harvestWindowEndDays   Int
  operations             Json     @default("[]")
  cropType               CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOTE: Postgres treats NULLs as distinct here, so this only guards the
  // per-user rows; base rows (userId NULL) are kept unique by the code
  // paths that write them (find-then-write, never blind create).
  @@unique([cropTypeId, userId])
  @@map("crop_schedules")
}

model ActionToken {
  id        String    @id @default(uuid())
  userId    String
  type      String
  tokenHash String    @unique
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("action_tokens")
}

model Sensor {
  id         String    @id @default(uuid())
  farmId     String
  fieldId    String?
  name       String
  sensorType String
  apiKey     String    @unique @default(uuid())
  lastSeenAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  farm       Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  readings   SensorReading[]

  @@map("sensors")
}

model SensorReading {
  id          String   @id @default(uuid())
  sensorId    String
  value       Decimal  @db.Decimal(12, 4)
  unit        String
  recordedAt  DateTime
  createdAt   DateTime @default(now())
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@map("sensor_readings")
}

model AutomationRule {
  id                 String    @id @default(uuid())
  farmId             String
  name               String
  sensorCondition    Json
  forecastCondition  Json?
  action             Json
  isActive           Boolean   @default(true)
  minIntervalMinutes Int       @default(60)
  lastTriggeredAt    DateTime?
  createdAt          DateTime  @default(now())
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}
